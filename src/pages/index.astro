---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, image, gallery } from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
---
<BaseLayout title={`${site.name} — ${site.title}`} description="Güven ÇALIŞKAN — engineer, software engineer, project manager and multidisciplinary digital artist.">
  <section class="hero">
    <div class="hero-copy">
      <div class="hero-index">/ 001 — Personal portfolio</div>
      <p class="kicker">Engineer × Technology × Art</p>
      <h1>Güven<br><span>Çalışkan</span></h1>
      <p class="hero-sub">Engineer, software practitioner, project manager and multidisciplinary digital artist. Different disciplines, one practice: making things work better.</p>
      <div class="hero-actions">
        <a class="button" href={href('/gallery/')}>Enter gallery ↗</a>
        <a class="quiet-link" href={href('/profile/')}>Profile</a>
      </div>
    </div>
    <div class="hero-art-wrap">
      <div class="hero-art-frame"></div>
      <img class="hero-art" src={image('banner.png')} alt="Selected artwork from Güven Çalışkan's portfolio" fetchpriority="high">
    </div>
  </section>
  <section class="home-strip">
    <span>Selected practice</span>
    <strong>Engineering thinking / creative execution</strong>
    <a href={href('/about/')}>About me →</a>
  </section>
</BaseLayout>
