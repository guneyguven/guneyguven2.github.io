---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, image } from '../data/site';
---
<BaseLayout title={`${site.name} — ${site.title}`} description="Güven ÇALIŞKAN — engineer, software engineer, project manager and multidisciplinary digital artist.">
  <section class="hero">
    <div class="hero-panel">
      <img class="hero-art" src={image('banner.png')} alt="Güven Çalışkan — multidisciplinary digital artist" fetchpriority="high">
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="kicker">Engineer & Multidisciplinary Digital Artist</p>
        <h1>Güven<br><span>ÇALIŞKAN</span></h1>
        <p class="hero-role">Engineer<br>& Multidisciplinary Digital Artist</p>
        <div class="hero-actions"><a class="button" href="/gallery/">Explore the work</a><a class="quiet-link" href="/profile/">View profile →</a></div>
      </div>
    </div>
  </section>
  <section class="home-intro">
    <div><p class="kicker">A multidisciplinary practice</p><h2>Engineering thinking.<br>Creative execution.</h2></div>
    <p>I work across engineering, software, project management, continuous improvement and visual art — using different disciplines as tools for solving different kinds of problems.</p>
  </section>
</BaseLayout>
