---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileCards } from '../data/site';
---
<BaseLayout title="Profile — Güven ÇALIŞKAN" description="Professional profile of Güven ÇALIŞKAN — engineer, software specialist, project manager, digital artist and Kaizen practitioner.">
  <section class="page">
    <div class="page-head"><p class="kicker">What I do</p><h1>Profile</h1><p class="lead">A deliberately mixed toolkit: engineering, software, project leadership, continuous improvement and visual art.</p></div>
    <div class="profile-grid">
      {profileCards.map(([title, text, symbol]) => <article class="card"><div class="card-symbol">{symbol}</div><h2>{title}</h2><p>{text}</p></article>)}
    </div>
    <section class="stack" aria-label="Technology stack">
      <div class="stack-label">Technology stack</div>
      <div class="marquee" aria-hidden="true"><span>JavaScript</span><span>React</span><span>Next.js</span><span>Python</span><span>Node.js</span><span>MongoDB</span><span>Git</span><span>GitHub</span><span>PyTorch</span><span>HTML</span><span>CSS</span><span>JavaScript</span><span>React</span><span>Next.js</span><span>Python</span><span>Node.js</span><span>MongoDB</span><span>Git</span><span>GitHub</span><span>PyTorch</span><span>HTML</span><span>CSS</span></div>
    </section>
  </section>
</BaseLayout>
